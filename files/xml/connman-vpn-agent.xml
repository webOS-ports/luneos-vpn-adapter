<?xml version="1.0"?>
<!DOCTYPE node PUBLIC "-//freedesktop//DTD D-BUS Object Introspection 1.0//EN"
 "http://www.freedesktop.org/standards/dbus/1.0/introspect.dtd">
<!--
  net.connman.vpn.Agent, as CALLED BY connman-vpnd (connman 2.0) - this is the
  server side: we implement this interface and export it on our own bus
  connection, then hand connman-vpnd the object path via
  net.connman.vpn.Manager.RegisterAgent().

  Derived from connman's doc/vpn-agent-api.txt, cross-checked against the
  actual caller in src/agent.c (connman_agent_queue_message /
  connman_agent_cancel / send_cancel_request) and vpn/plugins/openvpn.c's
  RequestInput call site:

    - RequestInput/ReportError take the *service* (VPN connection) object path
      as their first argument, matching vpn_agent_append_host_and_name() being
      handed the provider whose D-Bus path is used verbatim.
    - RequestInput's reply is read by connman as a single top-level a{sv} arg
      (dbus_message_iter_init + one recurse straight into the dict), not a
      wrapped struct.
    - Cancel() takes no arguments and expects no reply value. connman's
      src/agent.c serialises requests per registered agent (one
      "agent->pending" call in flight, further ones queued), so at most one
      RequestInput is ever outstanding against us at a time; Cancel() always
      refers to that one pending call.
-->
<node>
  <interface name="net.connman.vpn.Agent">
    <method name="Release"/>
    <method name="ReportError">
      <arg name="service" type="o" direction="in"/>
      <arg name="error" type="s" direction="in"/>
    </method>
    <method name="RequestInput">
      <arg name="service" type="o" direction="in"/>
      <arg name="fields" type="a{sv}" direction="in"/>
      <arg name="result" type="a{sv}" direction="out"/>
    </method>
    <method name="Cancel"/>
  </interface>
</node>
